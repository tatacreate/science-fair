rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDailyCheckin(data) {
      return data.keys().hasAll(['id', 'userId', 'sleepQuality', 'mentalHealth', 'overallFeeling'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.sleepQuality is number && data.sleepQuality >= 1 && data.sleepQuality <= 10
        && data.mentalHealth is string && data.mentalHealth.size() <= 200
        && data.overallFeeling is string && data.overallFeeling.size() <= 1000;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'authorId', 'title', 'body'])
        && data.id is string && data.id.size() <= 128
        && data.authorId is string && data.authorId == request.auth.uid
        && data.title is string && data.title.size() <= 150
        && data.body is string && data.body.size() <= 5000;
    }

    match /daily_checkins/{checkinId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(checkinId) && isValidDailyCheckin(incoming());
      allow update: if isSignedIn() && isValidId(checkinId) && isValidDailyCheckin(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /medical_notes/{noteId} {
      allow read: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(incoming());
      allow update: if isSignedIn() && isValidId(noteId) && isValidNote(incoming()) && incoming().authorId == existing().authorId;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
